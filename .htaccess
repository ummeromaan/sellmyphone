RewriteEngine On

# No hardcoded RewriteBase - Apache uses the folder this .htaccess file
# sits in as the base automatically. This is what makes the same file
# work both on localhost (e.g. /sellmyphone/) and on the live domain
# (root), without editing anything when you deploy.

# Blog single post: /blog/some-post-slug  ->  blog-single.php?slug=some-post-slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog-single.php?slug=$1 [L,QSA]

# Redirect *.php URLs to their clean version, e.g. /blog.php -> /blog
# (no longer tied to a fixed "/sellmyphone/" prefix, works at any depth)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]


RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
